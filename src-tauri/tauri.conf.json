{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AnotherKeepass",
  "version": "0.1.0",
  "identifier": "app.anotherkeepass.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AnotherKeepass",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.pwnedpasswords.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "KeePass-compatible password manager",
    "category": "Utility"
  }
}