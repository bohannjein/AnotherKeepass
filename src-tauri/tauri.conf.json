{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AnotherKeepass",
  "version": "0.2.0",
  "identifier": "app.anotherkeepass.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AnotherKeepass",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.pwnedpasswords.com"
    }
  },
  "bundle": {
    "publisher": "bohannjein",
    "copyright": "Copyright (c) 2026 bohannjein. GPL-3.0-or-later",
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "KeePass-compatible password manager",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4OUY3NEFDMUY2QzRGN0IKUldSN1Qyd2ZySFNmR05YL0N5VjhxdGdYTHIrUXF6M1NncmYrTm83V0Naekg2SzlEeGl3YjhqVWwK",
      "endpoints": [
        "https://github.com/bohannjein/AnotherKeepass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
