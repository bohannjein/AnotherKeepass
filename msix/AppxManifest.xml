<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package for the Microsoft Store. scripts/build-msix.mjs fills the {{…}} values:
     IDENTITY_NAME, PUBLISHER and PUBLISHER_NAME come from Partner Center
     (Product management > Product identity), VERSION from package.json. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop6 rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AnotherKeepass</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- browser integration: the native messaging manifests and their registry keys must be
         visible to Chrome, Edge and Firefox, so they are not redirected into the package -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="AnotherKeepass" Executable="anotherkeepass.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="AnotherKeepass"
        Description="KeePass-compatible password manager"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- browsers start the native messaging host through this alias -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="anotherkeepass.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="anotherkeepass.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- "Open at login" (switched by the app, off until the user turns it on) -->
        <uap5:Extension Category="windows.startupTask" Executable="anotherkeepass.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--autostart">
          <uap5:StartupTask TaskId="AnotherKeepassStartup" Enabled="false" DisplayName="AnotherKeepass" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- needed for the two "virtualization disabled" settings above (browser integration) -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
